ADMIN_PASSPHRASE=replace-with-your-owner-passphrase
ADMIN_RECOVERY_TOKEN=replace-with-a-separate-long-random-token
# Leave DATABASE_URL unset for local SQLite. Heroku Postgres supplies it automatically.
DATABASE_URL=
PORTFOLIO_DOMAIN=portfolio.example.com
PORTFOLIO_BASE_URL=https://portfolio.example.com
PORTFOLIO_ALLOWED_ORIGINS=https://portfolio.example.com
PORTFOLIO_TRUST_PROXY_HEADERS=true
PORTFOLIO_SECURE_COOKIES=true
PORTFOLIO_MAX_DATABASE_ASSET_BYTES=268435456
